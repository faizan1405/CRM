generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id               String     @id @default(uuid())
  name             String
  phone            String
  email            String?
  business         String?
  industry         String?
  leadSource       String?
  budget           Decimal?   @db.Decimal(12, 2)
  status           LeadStatus @default(NEW)
  quotedAmount     Decimal?   @db.Decimal(12, 2)
  lastContactDate  DateTime?  @db.Date
  nextFollowUpDate DateTime?  @db.Date
  notes            String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([leadSource])
  @@index([createdAt])
}
