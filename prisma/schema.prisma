generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(ADMIN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  activities   LeadActivity[]
}

model Lead {
  id               String         @id @default(uuid())
  name             String
  phone            String
  email            String?
  business         String?
  industry         String?
  leadSource       String?
  budget           Decimal?       @db.Decimal(12, 2)
  status           LeadStatus     @default(NEW)
  quotedAmount     Decimal?       @db.Decimal(12, 2)
  lastContactDate  DateTime?      @db.Date
  nextFollowUpDate DateTime?      @db.Date
  notes            String?        @db.Text
  followUps        FollowUp[]
  activities       LeadActivity[]
  aiInsight        LeadAIInsight?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([leadSource])
  @@index([createdAt])
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model FollowUp {
  id          String         @id @default(uuid())
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  type        FollowUpType
  status      FollowUpStatus @default(PENDING)
  note        String?        @db.Text
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
  @@index([status])
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  FOLLOWUP_CREATED
  FOLLOWUP_RESCHEDULED
  FOLLOWUP_COMPLETED
  FOLLOWUP_CANCELLED
}

model LeadActivity {
  id              String       @id @default(uuid())
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type            ActivityType
  message         String       @db.Text
  metadata        Json?
  createdByUserId String?
  createdByUser   User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())

  @@index([leadId])
  @@index([createdAt])
}

enum AIPriority {
  CRITICAL
  IMPORTANT
  NORMAL
}

enum AIActionType {
  CALL
  FOLLOWUP
  WHATSAPP
  EMAIL
  REVIEW
  WARNING
  OTHER
}

model LeadAIInsight {
  id                    String        @id @default(uuid())
  leadId                String        @unique
  lead                  Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score                 Int
  priority              AIPriority
  scoreReason           String        @db.Text
  recommendedAction     String        @db.Text
  recommendedActionType AIActionType?
  factorBreakdown       Json?
  lastAnalyzedAt        DateTime      @default(now())
  needsRefresh          Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([priority])
  @@index([score])
  @@index([needsRefresh])
  @@index([lastAnalyzedAt])
}

