generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum QuickStatus {
  NONE
  CONTACTED
  INTERESTED
  CALL_NOT_PICK
  CALL_AGAIN
}

model User {
  id               String               @id @default(uuid())
  name             String
  email            String               @unique
  passwordHash     String
  role             Role                 @default(ADMIN)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  activities       LeadActivity[]
  createdTemplates WhatsAppTemplate[]
  lossEvents       LeadLossEvent[]
  notifications    SalesNotification[]
  personalNotes    PersonalNote[]
  mobileSubscriptions MobilePushSubscription[]
}

model Lead {
  id               String              @id @default(uuid())
  name             String
  phone            String
  email            String?
  business         String?
  industry         String?
  leadSource       String?
  budget           Decimal?            @db.Decimal(12, 2)
  status           LeadStatus          @default(NEW)
  quickStatus      QuickStatus         @default(NONE)
  isWaste          Boolean             @default(false)
  quotedAmount     Decimal?            @db.Decimal(12, 2)
  lastContactDate  DateTime?           @db.Date
  nextFollowUpDate DateTime?           @db.Date
  notes            String?             @db.Text
  deletedAt        DateTime?
  followUps        FollowUp[]
  activities       LeadActivity[]
  aiInsight        LeadAIInsight?
  lossEvents       LeadLossEvent[]
  notifications    SalesNotification[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([quickStatus])
  @@index([phone])
  @@index([email])
  @@index([leadSource])
  @@index([createdAt])
  @@index([deletedAt])
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model FollowUp {
  id          String         @id @default(uuid())
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  type        FollowUpType
  status      FollowUpStatus @default(PENDING)
  note        String?        @db.Text
  completedAt  DateTime?
  submissionId String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
  @@index([status])
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  FOLLOWUP_CREATED
  FOLLOWUP_RESCHEDULED
  FOLLOWUP_COMPLETED
  FOLLOWUP_CANCELLED
  WHATSAPP_OPENED
}

model LeadActivity {
  id              String       @id @default(uuid())
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type            ActivityType
  message         String       @db.Text
  metadata        Json?
  createdByUserId String?
  createdByUser   User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())

  @@index([leadId])
  @@index([createdAt])
}

enum AIPriority {
  CRITICAL
  IMPORTANT
  NORMAL
}

enum AIActionType {
  CALL
  FOLLOWUP
  WHATSAPP
  EMAIL
  REVIEW
  WARNING
  OTHER
}

model LeadAIInsight {
  id                    String        @id @default(uuid())
  leadId                String        @unique
  lead                  Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score                 Int
  priority              AIPriority
  scoreReason           String        @db.Text
  recommendedAction     String        @db.Text
  recommendedActionType AIActionType?
  factorBreakdown       Json?
  lastAnalyzedAt        DateTime      @default(now())
  needsRefresh          Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([priority])
  @@index([score])
  @@index([needsRefresh])
  @@index([lastAnalyzedAt])
}

enum WhatsAppTemplateCategory {
  FIRST_CONTACT
  AFTER_CALL
  FOLLOW_UP
  QUOTATION_SENT
  QUOTATION_FOLLOW_UP
  NO_RESPONSE
  FINAL_FOLLOW_UP
  CONVERTED_THANK_YOU
}

model WhatsAppTemplate {
  id              String                   @id @default(uuid())
  title           String
  category        WhatsAppTemplateCategory
  message         String                   @db.Text
  isActive        Boolean                  @default(true)
  sortOrder       Int                      @default(0)
  createdByUserId String?
  createdByUser   User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([category])
  @@index([isActive])
}

enum SampleType {
  LIVE
  DEMO
}

model WebsiteSample {
  id          String     @id @default(uuid())
  label       String?
  url         String
  category    String
  type        SampleType @default(LIVE)
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category])
  @@index([type])
  @@index([isActive])
}

model WebsitePackage {
  id              String   @id @default(uuid())
  name            String
  price           Decimal  @db.Decimal(12, 2)
  isStartingPrice Boolean  @default(false)
  inclusions      String   @db.Text
  hosting         String?
  domain          String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

enum LeadLossReason {
  PRICE
  NO_RESPONSE
  TIMING
  COMPETITOR
  TRUST
  NOT_QUALIFIED
  REQUIREMENT_CHANGED
  NO_URGENCY
  OTHER
}

model LeadLossEvent {
  id              String         @id @default(uuid())
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reason          LeadLossReason
  note            String?        @db.Text
  lostAt          DateTime       @default(now())
  createdByUserId String?
  createdByUser   User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([leadId])
  @@index([reason])
  @@index([lostAt])
}

enum NotificationPriority {
  CRITICAL
  IMPORTANT
  NORMAL
}

enum NotificationStatus {
  UNREAD
  READ
  RESOLVED
  DISMISSED
}

enum NotificationType {
  OVERDUE_FOLLOWUP
  FOLLOWUP_DUE_TODAY
  NEW_LEAD_NOT_CONTACTED
  STALE_LEAD
  HOT_LEAD_ATTENTION
  HIGH_VALUE_OPPORTUNITY
  PROPOSAL_FOLLOWUP
  AI_RECOMMENDED_ACTION
  MISSED_FOLLOWUP
}

model SalesNotification {
  id                String               @id @default(uuid())
  userId            String?
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type              NotificationType
  priority          NotificationPriority
  title             String
  reason            String               @db.Text
  recommendedAction String               @db.Text
  dedupeKey         String               @unique
  status            NotificationStatus   @default(UNREAD)
  readAt            DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([userId])
  @@index([leadId])
}

model DailySalesBriefing {
  id           String   @id @default(uuid())
  userId       String   @default("system")
  briefingDate String
  summary      String   @db.Text
  metadata     Json
  generatedAt  DateTime @default(now())

  @@unique([userId, briefingDate])
  @@index([briefingDate])
}

model PersonalNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isPinned])
  @@index([createdAt])
}

model MobilePushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String?
  auth      String?
  platform  String   @default("web")
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

model DispatchedMobileAlert {
  id           String   @id @default(uuid())
  dedupeKey    String   @unique
  userId       String?
  leadId       String?
  category     String
  title        String
  body         String   @db.Text
  dispatchedAt DateTime @default(now())
  success      Boolean  @default(true)

  @@index([dedupeKey])
  @@index([userId])
  @@index([dispatchedAt])
}
